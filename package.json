{
  "name": "coinpower-mac",
  "version": "1.0.5",
  "description": "",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dist": "APPLE_KEYCHAIN_PROFILE=CoinPowerNotary electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "nl.coinpower.mac",
    "productName": "CoinPower",
    "electronLanguages": ["nl", "en"],
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "meldingsiconen/**",
      "package.json"
    ],
    "mac": {
      "icon": "icon.icns",
      "category": "public.app-category.finance",
      "target": ["dmg"],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "title": "CoinPower"
    },
    "win": {
      "icon": "icon.ico",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CoinPower-${version}-setup.${ext}"
    }
  }
}